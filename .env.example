# Job Hunt MVP Environment Variables
# Default is standalone mode using development mock auth and local storage persistence.

# Authentication Adapter: 'mock' (default for standalone dev) or 'supabase'
VITE_AUTH_ADAPTER=mock

# Supabase Configuration (Optional for standalone MVP, required for production Supabase deployment)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Production safety flag: Must be explicitly 'true' if mock auth is permitted in a production build
VITE_ALLOW_MOCK_AUTH=false
